  m_Name: 1 Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  dialogLines:
  - dialogLine: Where did you find that?
    dialogAudio: {fileID: 0}
    clipLength: 3
    speaker: 1
  - dialogLine: In the drawing room. Lady Rosethorne's death notice, I believe. Your
      mother.
    dialogAudio: {fileID: 0}
    clipLength: 4
    speaker: 0
  - dialogLine: Yes. She died the day I was born. I never knew her, not even the
      sound of her voice.
    dialogAudio: {fileID: 0}
    clipLength: 4
    speaker: 1
